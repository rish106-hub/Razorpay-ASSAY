# Required only for live MCA acquisition from data.gov.in. Local tests and
# static validation must not require the real value.
DATA_GOV_IN_API_KEY=

# Read-only backend artifact and explicit frontend origins. The evidence path
# points to a generated readiness JSON report, never raw MCA or NSE data.
ASSAY_EVIDENCE_REPORT_PATH=
ASSAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Add optional explanation-layer keys only when that feature is approved. Never
# add real values to this repository.
